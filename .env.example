# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit it.

# ---------------------------------------------------------------------------
# Server-side secrets (never exposed to the browser)
# ---------------------------------------------------------------------------

# GEMINI_API_KEY: Required for Gemini AI API calls. Used only by server.ts and
# scripts/backfill-embeddings.ts. In production this is mounted from Google
# Cloud Secret Manager; AI Studio injects it at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Firebase web client config (VITE_ prefixed -> inlined into the browser bundle)
#
# These are NOT secrets: Firebase web config is public by design and is visible
# to anyone who opens the deployed app. Access control comes from
# firestore.rules plus HTTP-referrer restrictions on the API key in the Google
# Cloud console. They live here so the repo is not tied to one project.
# Find these values in Firebase console -> Project settings -> Your apps.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="my-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="my-project-id"
VITE_FIREBASE_STORAGE_BUCKET="my-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"

# Optional. Leave empty if unused.
VITE_FIREBASE_MEASUREMENT_ID=""

# Optional. Named Firestore database ID. Leave empty to use the "(default)" database.
VITE_FIREBASE_DATABASE_ID=""

# Optional. Google OAuth web client ID, if you wire up OAuth outside Firebase Auth.
VITE_FIREBASE_OAUTH_CLIENT_ID=""

# Optional. reCAPTCHA Enterprise site key for Firebase App Check.
VITE_FIREBASE_RECAPTCHA_SITE_KEY=""
